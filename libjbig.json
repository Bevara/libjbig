{
    "name": "libjbig",
    "version": "1.0.2",
    "description": "JBIG image decoder",
    "filters":["jbigdec"],
    "help": "This filter decodes JBIG (ITU-T T.82) bi-level images using JBIG-KIT.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libjbig.accessor",
    "filter_source":{
        "jbigdec" : "dec_jbig.c"
    },
    "extension":{
      "jbg" : "img",
      "jbig" : "img"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1"],
    "patents": {
        "status": "expired",
        "note": "JBIG (ITU-T T.82)",
        "checked": "2026-10-16"
    }
}
